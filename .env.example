# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Vision + answering model. Any Gemini model that supports image input and JSON output.
GEMINI_MODEL=gemini-3.5-flash
# Optional: a cheaper/faster model only for reading chart pages (higher free-tier limits), e.g. gemini-3.5-flash-lite (the free tier of gemini-3.5-flash is only ~20 requests)
# GEMINI_VISION_MODEL=
# Embedding model (output is truncated to EMBEDDING_DIMENSIONS).
# Only used when EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Keeping Gemini usage low ---
# Embeddings: "local" runs a small model inside Node (free, offline; first run downloads ~35 MB into DATA_DIR/models).
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
# Leave EMBEDDING_DIMENSIONS unset: 384 for the local model, 768 for Gemini embeddings.
# Page analysis: "hybrid" = local layout analysis for every page, Gemini vision only for chart/image pages (max VISION_MAX_PAGES).
#                "local"  = never call Gemini vision.   "vision" = Gemini vision on every page.
INGEST_MODE=hybrid
VISION_MAX_PAGES=15
# Parallel vision calls; keep 1 on the free tier to stay under requests-per-minute limits.
VISION_CONCURRENCY=1

# --- Qdrant Cloud (https://cloud.qdrant.io -> free cluster -> API keys) ---
QDRANT_URL=https://YOUR-CLUSTER-ID.REGION.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=imac_rag_chunks

# --- Local persistent storage (PDFs, manifest, page-image cache) ---
DATA_DIR=./data

# --- Limits ---
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=60
